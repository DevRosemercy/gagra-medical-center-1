/* Gagra Medical Centre - Main Stylesheet */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #0369a1;
  --primary-dark: #0284c7;
  --bg-body: #f8fafc;
  --bg-card: #ffffff;
  --text-primary: #1e293b;
  --border-color: #e2e8f0;
  --danger: #dc2626;
  --danger-dark: #b91c1c;
}

body.dark {
  --primary: #38bdf8;
  --primary-dark: #7dd3fc;
  --bg-body: #0f172a;
  --bg-card: #1e293b;
  --text-primary: #f1f5f9;
  --border-color: #334155;
  --danger: #ef4444;
}

body {
  font-family: 'Inter', sans-serif;
  background-color: var(--bg-body);
  color: var(--text-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
  scroll-behavior: smooth;
}

/* Utility Classes */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

.sr-only:focus {
  position: fixed;
  top: 1rem;
  left: 1rem;
  width: auto;
  height: auto;
  padding: 1rem;
  clip: auto;
  background: white;
  color: var(--primary);
  z-index: 9999;
}

.container {
  max-width: 1280px;
  margin: 0 auto;
}

/* Button Styles */
.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  transition: all 0.3s ease;
  color: white;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 600;
  text-decoration: none;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(3, 105, 161, 0.35);
}

.btn-outline-white {
  background: transparent;
  color: white;
  border: 2px solid white;
  transition: all 0.3s ease;
  font-weight: 700;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.btn-outline-white:hover {
  background: white;
  color: var(--primary);
}

.btn-emergency {
  background: var(--danger);
  color: white;
  animation: pulse-ring 1.5s infinite;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.btn-emergency:hover {
  background: var(--danger-dark);
  transform: scale(1.05);
}

@keyframes pulse-ring {
  0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
  70% { box-shadow: 0 0 0 15px rgba(220, 38, 38, 0); }
  100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
}

/* WhatsApp Float Animation */
.wa-float {
  animation: pulse-green 2s infinite;
}

@keyframes pulse-green {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
  70% { transform: scale(1.05); box-shadow: 0 0 0 18px rgba(37, 211, 102, 0); }
  100% { transform: scale(1); }
}

/* Ambulance Animation */
.ambulance-animate {
  animation: ambulanceMove 1s ease-in-out infinite;
}

@keyframes ambulanceMove {
  0% { transform: translateX(0); }
  50% { transform: translateX(10px); }
  100% { transform: translateX(0); }
}

/* Hero Fullscreen Slideshow */
.hero-fullscreen {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
}

.hero-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0;
  transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
}

.hero-slide.active {
  opacity: 1;
  z-index: 2;
}

.hero-content-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  color: white;
  padding: 2rem;
}

.hero-title {
  font-size: 3.5rem;
  font-weight: 800;
  margin-bottom: 1rem;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  animation: fadeInUp 0.8s ease-out;
}

.hero-subtitle {
  font-size: 1.25rem;
  max-width: 600px;
  margin-bottom: 2rem;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.hero-buttons {
  animation: fadeInUp 0.8s ease-out 0.4s both;
}

.text-gradient {
  background: linear-gradient(135deg, #38bdf8, #7dd3fc);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Navigation Dots */
.hero-dots {
  position: absolute;
  bottom: 2rem;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 1rem;
  z-index: 10;
}

.hero-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  cursor: pointer;
  transition: all 0.3s ease;
}

.hero-dot.active,
.hero-dot:hover {
  background: white;
  transform: scale(1.3);
}

/* Navigation Arrows */
.hero-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  color: white;
  border: none;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  z-index: 10;
}

.hero-nav:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-50%) scale(1.1);
}

.hero-prev { left: 2rem; }
.hero-next { right: 2rem; }

/* Scroll Indicator */
.scroll-indicator {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  color: white;
  z-index: 10;
  text-align: center;
  cursor: pointer;
}

.animate-bounce {
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(10px); }
}

/* Card Styles */
.card-bg {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
}

/* Image Hover Effects */
.img-zoom {
  transition: transform 0.5s ease, box-shadow 0.3s ease;
}

.img-zoom:hover {
  transform: scale(1.03);
  box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.2);
}

/* Card Hover Effects */
.service-card, .blog-card, .team-card {
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.service-card:hover, .blog-card:hover, .team-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 25px 40px -15px rgba(0, 0, 0, 0.2);
}

/* Chatbot Styles */
.chat-message-user {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
}

.chat-message-bot {
  background-color: #e2e8f0;
  color: #1e293b;
}

body.dark .chat-message-bot {
  background-color: #334155;
  color: #f1f5f9;
}

/* Toast Notification */
.toast-notification {
  position: fixed;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%);
  background: #1e293b;
  color: white;
  padding: 12px 24px;
  border-radius: 50px;
  z-index: 1000;
  font-size: 14px;
  animation: fadeUpOut 3s ease-in-out forwards;
}

@keyframes fadeUpOut {
  0% { opacity: 0; transform: translateX(-50%) translateY(20px); }
  15% { opacity: 1; transform: translateX(-50%) translateY(0); }
  85% { opacity: 1; transform: translateX(-50%) translateY(0); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-20px); visibility: hidden; }
}

/* Fade In Animation */
.fade-in-up {
  animation: fadeInUp 0.6s ease-out forwards;
}

/* Scrollbar */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 3px; }

/* Responsive Design */
@media (max-width: 768px) {
  .hero-title { font-size: 2rem; }
  .hero-subtitle { font-size: 0.9rem; }
  .hero-nav { width: 36px; height: 36px; font-size: 1rem; }
  .hero-prev { left: 1rem; }
  .hero-next { right: 1rem; }
}

/* Print Styles */
@media print {
  .wa-float, #chatbotToggle, #chatbotWindow, footer, .fixed { display: none !important; }
}
